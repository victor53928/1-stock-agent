# 노션 내부 통합(Internal Integration) 토큰
# https://www.notion.so/my-integrations 에서 생성 후,
# 대상 데이터베이스 페이지에서 "연결 추가"로 이 통합을 공유해야 한다.
NOTION_TOKEN=

# 뉴스 요약을 저장할 노션 데이터베이스 ID (대시 포함/미포함 모두 가능)
NOTION_DATABASE_ID=

# 네이버 오픈API (검색 > 뉴스) 클라이언트 정보
# https://developers.naver.com/apps/#/register 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 뉴스 검색 키워드 (기본값: 증시)
NAVER_NEWS_QUERY=증시
